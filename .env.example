TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=provider/model-name:free
BOT_MODE=polling
# Required only for webhook mode; set the complete public HTTPS endpoint URL.
WEBHOOK_URL=https://your-service.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_64_character_hex_secret
# Render supplies PORT automatically.
PORT=10000
